# 後端 API 位置（正式部署時改成你的後端網址）
VITE_API_BASE=/api
# Google OAuth 用戶端 ID（到 Google Cloud Console 申請）
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# WebSocket 即時客服聊天端點（選填）。留空時預設走同源 /ws-chat（適合 docker-compose
# 或後端同源部署）；若前後端分離部署且中間的代理不支援 WS（如 Netlify redirect），
# 改填後端的 wss:// 網址直連。
# VITE_WS_BASE=wss://your-backend.onrender.com
