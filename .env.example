# 複製此檔為 .env，在 docker compose up 前填入你的值
# .env 已被 .gitignore 排除，不會進版控

# --- MySQL ---
# root 帳號的密碼（同時是後端連 DB 用的密碼）
MYSQL_ROOT_PASSWORD=root

# --- 後端 JWT ---
# 至少 32 bytes（HS256 要求），請用密碼產生器生
# 例： openssl rand -base64 48
JWT_SECRET=please-change-this-to-a-strong-random-secret-at-least-32-bytes

# --- Google OAuth（選用，未設定時 Google 登入按鈕會隱藏） ---
# 到 https://console.cloud.google.com/apis/credentials 建立「OAuth 用戶端 ID」
# 同一個 client-id 要分別灌進前端與後端
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- 登入限流信任的代理（選用） ---
# 若後端部署在反向代理 / 負載平衡器之後，且想依「真實用戶端 IP」限流，
# 在此填入該代理的 IP（逗號分隔）。留空＝不信任 X-Forwarded-For，一律用直接連線位址。
TRUSTED_PROXIES=

# --- 訂單確認信（選用，未設定 MAIL_HOST 時會安全跳過寄信，不影響付款流程） ---
# 例：Gmail 需開應用程式密碼；MAIL_HOST=smtp.gmail.com, MAIL_PORT=587
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@voyago.example.com
